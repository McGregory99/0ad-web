+#ifndef INCLUDED_AIREMOTE
+#define INCLUDED_AIREMOTE
+
+#include <functional>
+#include <string>
+
+/**
+ * Remote AI (WebAssembly builds): the AI scripts run in the host JavaScript engine
+ * (tools/wasm/ai/ai-worker.js) instead of the SpiderMonkey interpreter compiled to wasm.
+ * CCmpAIManager sends one request per AI step and blocks until the worker answers; while it
+ * waits, the worker's synchronous callbacks (simulation queries, templates, paths, file reads)
+ * are answered on the engine thread by the given service function.
+ */
+namespace AIRemote
+{
+/**
+ * Kinds of worker callbacks, see tools/wasm/ai/ai-worker.js.
+ */
+enum ServiceKind
+{
+	SERVICE_DISPATCH = 1,       // codec request for the AI realm dispatcher (Engine.*, Sim, SimEngine, logging)
+	SERVICE_MODULE_CODE = 3,    // VFS path of an AI module -> its code including appendices
+	SERVICE_GLOBAL_SCRIPTS = 4, // -> newline-separated VFS paths of the global scripts
+	SERVICE_GLOBAL_CODE = 5     // VFS path of a global script -> its code
+};
+
+using Service = std::function<std::string(int kind, const std::string& request)>;
+
+/**
+ * True when the remote AI is available in this build and enabled with ZEROAD_AI_REMOTE=1.
+ */
+bool Enabled();
+
+/**
+ * Sends a request to the AI worker and waits for its reply, serving callbacks meanwhile.
+ * Returns false when the worker is not available.
+ */
+bool Call(const std::string& request, std::string& reply, const Service& service);
+}
+
+#endif // INCLUDED_AIREMOTE
