+#elif defined(__EMSCRIPTEN__)
+	// WebGL2 (GLES 3.0) supports hardware depth comparisons, so enable the same
+	// compare mode the desktop path uses. Our glad header is GLES 2 only, hence the
+	// raw enum values (GL_TEXTURE_COMPARE_MODE / GL_COMPARE_REF_TO_TEXTURE /
+	// GL_TEXTURE_COMPARE_FUNC / GL_NONE).
+	if (IsDepthFormat(format))
+	{
+		if (defaultSamplerDesc.compareEnabled)
+		{
+			glTexParameteri(GL_TEXTURE_2D, 0x884C, 0x884E);
+			glTexParameteri(GL_TEXTURE_2D, 0x884D, Mapping::FromCompareOp(defaultSamplerDesc.compareOp));
+		}
+		else
+			glTexParameteri(GL_TEXTURE_2D, 0x884C, 0);
+	}
 #endif
 
