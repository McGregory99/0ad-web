+	static bool ReadScriptFile(const VfsPath& path, std::string& code, std::string& error)
+	{
+		if (!VfsFileExists(path))
+		{
+			error = "The file \"" + path.string8() + "\" does not exist.";
+			return false;
+		}
+		if (path.Extension() != L".js")
+		{
+			error = "The file \"" + path.string8() + "\" is not a JavaScript file.";
+			return false;
+		}
+		CVFSFile file;
+		if (file.Load(g_VFS, path) != PSRETURN_OK)
+		{
+			error = "Failed to load file \"" + path.string8() + "\".";
+			return false;
+		}
+		code = file.DecodeUTF8();
+		return true;
+	}
