+// debug_printf writes to stdout, which (like any file write) blocks a thread other than the main
+// one in the browser build until the main thread serves it; see AppendLines. The line still
+// reaches the log files.
+static bool PrintsWithoutBlocking()
+{
+#ifdef __EMSCRIPTEN__
+	return emscripten_is_main_runtime_thread();
+#else
+	return true;
+#endif
+}
+
+void CLogger::AppendLines(const std::string& mainLine, const std::string& interestingLine)
+{
+#ifdef __EMSCRIPTEN__
+	// In the browser build a file write from any thread but the main one waits until the main
+	// thread serves it (Emscripten proxies file system calls synchronously), and the main thread
+	// can be busy for seconds (map loading, the first frames of a match). The network threads log
+	// every message they send or receive, so writing there stalls ENet until the peers time out.
+	// Lines logged off the main thread wait in memory for the main thread's next line or frame.
+	// The queue is capped for pages that render no frames for a long time (a hidden tab); lines
+	// beyond the cap are dropped from the files (they still reach the console and the screen).
+	if (!emscripten_is_main_runtime_thread())
+	{
+		constexpr size_t maxPending = 8 * 1024 * 1024;
+		if (m_PendingMainLog.size() + mainLine.size() <= maxPending)
+			m_PendingMainLog += mainLine;
+		if (m_PendingInterestingLog.size() + interestingLine.size() <= maxPending)
+			m_PendingInterestingLog += interestingLine;
+		return;
+	}
+	WritePendingLines();
+#endif
+	if (!interestingLine.empty())
+	{
+		m_InterestingLog << interestingLine;
+		m_InterestingLog.flush();
+	}
+	m_MainLog << mainLine;
+	m_MainLog.flush();
+}
+
+void CLogger::WritePendingLines()
+{
+	if (!m_PendingInterestingLog.empty())
+	{
+		m_InterestingLog << m_PendingInterestingLog;
+		m_InterestingLog.flush();
+		m_PendingInterestingLog.clear();
+	}
+	if (!m_PendingMainLog.empty())
+	{
+		m_MainLog << m_PendingMainLog;
+		m_MainLog.flush();
+		m_PendingMainLog.clear();
+	}
+}
