# Bug 2061321 - Handle argument underflow (formal-argument padding) in the PBL stack check.
# Upstream commit: https://github.com/mozilla-firefox/firefox/commit/e83443ea1399eae74401dbfe8d427e439eb77df3
# Apply with `patch -p1` from wasm/spidermonkey/mozjs-128.13.0, after 0001.
--- a/js/src/vm/PortableBaselineInterpret.cpp
+++ b/js/src/vm/PortableBaselineInterpret.cpp
@@ -6328,7 +6328,10 @@
   StackVal* base = reinterpret_cast<StackVal*>(pbs.base);
   StackVal* top = reinterpret_cast<StackVal*>(pbs.top);
   ssize_t margin = kStackMargin / sizeof(StackVal);
-  ssize_t needed = numActualArgs + state.script()->nslots() + margin;
+  size_t numFormals =
+      state.isInvoke() ? state.script()->function()->nargs() : 0;
+  ssize_t needed =
+      std::max(numActualArgs, numFormals) + state.script()->nslots() + margin;
   return (top - base) >= needed;
 }
 
