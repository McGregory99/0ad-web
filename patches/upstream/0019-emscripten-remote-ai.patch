+
+#include "AIRemote.h"
+
+#if defined(__EMSCRIPTEN__)
+
+#include <cstdlib>
+#include <cstring>
+#include <emscripten.h>
+#include <exception>
+#include <utility>
+#include <vector>
+
+extern "C"
+{
+// Implemented in tools/wasm/node-lib.js (Node worker_threads) and tools/wasm/web-lib.js.
+// Sends the request and blocks until the worker's final reply; returns its length in bytes,
+// or -1 when no worker is available.
+int zeroad_ai_remote_call(const char* request, size_t length);
+// Copies the last reply into out (as many bytes as zeroad_ai_remote_call returned).
+void zeroad_ai_remote_result(char* out);
+}
+
+namespace
+{
+const AIRemote::Service* g_Service = nullptr;
+std::vector<char> g_ServiceInput;
+std::string g_ServiceOutput;
+}
+
+extern "C"
+{
+// Called by the JS side while zeroad_ai_remote_call waits: it writes a worker callback into
+// this buffer, calls zeroad_ai_service and reads zeroad_ai_service_output.
+EMSCRIPTEN_KEEPALIVE char* zeroad_ai_service_input(size_t size)
+{
+	g_ServiceInput.resize(size + 1);
+	return g_ServiceInput.data();
+}
+
+EMSCRIPTEN_KEEPALIVE size_t zeroad_ai_service(int kind, size_t length)
+{
+	if (!g_Service)
+	{
+		g_ServiceOutput = "Eno AI request is active";
+		return g_ServiceOutput.size();
+	}
+	try
+	{
+		g_ServiceOutput = (*g_Service)(kind, std::string(g_ServiceInput.data(), length));
+	}
+	catch (const std::exception& e)
+	{
+		g_ServiceOutput = std::string("E") + e.what();
+	}
+	return g_ServiceOutput.size();
+}
+
+EMSCRIPTEN_KEEPALIVE const char* zeroad_ai_service_output()
+{
+	return g_ServiceOutput.data();
+}
+}
+
+bool AIRemote::Enabled()
+{
+	static const bool enabled = []
+	{
+		const char* value = std::getenv("ZEROAD_AI_REMOTE");
+		return value && std::strcmp(value, "1") == 0;
+	}();
+	return enabled;
+}
+
+bool AIRemote::Call(const std::string& request, std::string& reply, const Service& service)
+{
+	const Service* previous = std::exchange(g_Service, &service);
+	const int length = zeroad_ai_remote_call(request.data(), request.size());
+	g_Service = previous;
+	if (length < 0)
+		return false;
+	reply.resize(length);
+	if (length > 0)
+		zeroad_ai_remote_result(reply.data());
+	return true;
+}
+
+#else // !__EMSCRIPTEN__
+
+bool AIRemote::Enabled()
+{
+	return false;
+}
+
+bool AIRemote::Call(const std::string&, std::string&, const Service&)
+{
+	return false;
+}
+
+#endif // __EMSCRIPTEN__
