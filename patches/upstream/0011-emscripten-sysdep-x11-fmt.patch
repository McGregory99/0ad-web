diff --color -ruN a/source/lib/sysdep/os/emscripten/ecpu.cpp b/source/lib/sysdep/os/emscripten/ecpu.cpp
--- a/source/lib/sysdep/os/emscripten/ecpu.cpp	1970-01-01 01:00:00
+++ b/source/lib/sysdep/os/emscripten/ecpu.cpp	2026-11-06 22:06:24
@@ -0,0 +1,79 @@
+/* Copyright (C) 2026 Wildfire Games.
+ * This file is part of 0 A.D. (browser port additions).
+ * Licensed under the same MIT terms as the rest of source/lib.
+ */
+
+// Emscripten/browser implementation of os_cpu (no sysctl, no /proc).
+
+#include "precompiled.h"
+
+#include "lib/sysdep/os_cpu.h"
+#include "lib/bits.h"
+
+#include <emscripten/heap.h>
+#include <unistd.h>
+#ifdef __EMSCRIPTEN_PTHREADS__
+# include <emscripten/threading.h>
+#endif
+
+size_t os_cpu_NumProcessors()
+{
+	static size_t numProcessors;
+	if(numProcessors == 0)
+	{
+#ifdef __EMSCRIPTEN_PTHREADS__
+		const int cores = emscripten_num_logical_cores();
+		numProcessors = cores > 0 ? (size_t)cores : 1;
+#else
+		numProcessors = 1;
+#endif
+	}
+	return numProcessors;
+}
+
+uintptr_t os_cpu_ProcessorMask()
+{
+	static uintptr_t processorMask;
+	if(!processorMask)
+		processorMask = bit_mask<uintptr_t>(std::min<size_t>(os_cpu_NumProcessors(), sizeof(uintptr_t) * 8 - 1));
+	return processorMask;
+}
+
+size_t os_cpu_PageSize()
+{
+	static size_t pageSize;
+	if(!pageSize)
+		pageSize = (size_t)sysconf(_SC_PAGESIZE);
+	return pageSize;
+}
+
+size_t os_cpu_LargePageSize()
+{
+	return 0;
+}
+
+// Total memory the wasm heap may grow to, in MiB.
+size_t os_cpu_QueryMemorySize()
+{
+	return emscripten_get_heap_max() / MiB;
+}
+
+// Heap growth still possible, in MiB.
+size_t os_cpu_MemoryAvailable()
+{
+	const size_t max = emscripten_get_heap_max();
+	const size_t cur = emscripten_get_heap_size();
+	return (max > cur ? max - cur : 0) / MiB;
+}
+
+uintptr_t os_cpu_SetThreadAffinityMask(uintptr_t /*processorMask*/)
+{
+	return os_cpu_ProcessorMask();
+}
+
+Status os_cpu_CallByEachCPU(OsCpuCallback cb, uintptr_t cbData)
+{
+	for(size_t processor = 0; processor < os_cpu_NumProcessors(); processor++)
+		cb(processor, cbData);
+	return INFO::OK;
+}
diff --color -ruN a/source/lib/sysdep/os/emscripten/emscripten.cpp b/source/lib/sysdep/os/emscripten/emscripten.cpp
