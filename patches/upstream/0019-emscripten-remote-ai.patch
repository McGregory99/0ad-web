+u32 Fnv1a(const void* data, size_t size)
+{
+	u32 hash = 2166136261u;
+	for (size_t i = 0; i < size; ++i)
+	{
+		hash ^= static_cast<const u8*>(data)[i];
+		hash *= 16777619u;
+	}
+	return hash;
+}
