+#if AI_REMOTE
+/**
+ * Helper evaluated in the AI realm when the AI runs remotely: the codec (a copy of
+ * tools/wasm/ai/codec.js, keep both in sync) and the dispatcher that answers the worker's
+ * callbacks with the same Engine, Sim and SimEngine objects the in-process AI would use.
+ */
+const char* const AI_REMOTE_HELPER_JS = R"JS((function() {
+const Codec = (function() {
+	const TAG = '\u0000';
+	function replacer(key, value) {
+		if (value === undefined)
+			return TAG + 'u';
+		if (typeof value === 'number') {
+			if (Number.isNaN(value))
+				return TAG + 'n';
+			if (value === Infinity)
+				return TAG + 'i';
+			if (value === -Infinity)
+				return TAG + '-i';
+			if (value === 0 && 1 / value < 0)
+				return TAG + '-0';
+		}
+		if (typeof value === 'string' && value.charCodeAt(0) === 0)
+			return TAG + 's' + value;
+		if (value !== null && typeof value === 'object') {
+			// Brand checks, because the simulation's objects come from another realm.
+			const brand = Object.prototype.toString.call(value);
+			if (brand === '[object Set]')
+				return { [TAG + 'set']: Array.from(value) };
+			if (brand === '[object Map]')
+				return { [TAG + 'map']: Array.from(value) };
+			if (ArrayBuffer.isView(value) && brand !== '[object DataView]')
+				return { [TAG + 'ta']: value.constructor.name, data: Array.from(value) };
+		}
+		return value;
+	}
+	function revive(value) {
+		if (typeof value === 'string') {
+			if (value.charCodeAt(0) !== 0)
+				return value;
+			switch (value.slice(1)) {
+			case 'u': return undefined;
+			case 'n': return NaN;
+			case 'i': return Infinity;
+			case '-i': return -Infinity;
+			case '-0': return -0;
+			}
+			if (value[1] === 's')
+				return value.slice(2);
+			return value;
+		}
+		if (value === null || typeof value !== 'object')
+			return value;
+		if (Array.isArray(value)) {
+			for (let i = 0; i < value.length; ++i)
+				value[i] = revive(value[i]);
+			return value;
+		}
+		const taType = value[TAG + 'ta'];
+		if (taType !== undefined)
+			return new globalThis[taType](revive(value.data));
+		if (value[TAG + 'set'] !== undefined)
+			return new Set(revive(value[TAG + 'set']));
+		if (value[TAG + 'map'] !== undefined)
+			return new Map(revive(value[TAG + 'map']));
+		for (const key of Object.keys(value))
+			value[key] = revive(value[key]);
+		return value;
+	}
+	return {
+		encode: (value) => JSON.stringify([value], replacer),
+		decode: (text) => revive(JSON.parse(text))[0],
+	};
+})();
+function walk(root, path, length) {
+	let value = root === 'Sim' ? Sim : SimEngine;
+	for (let i = 0; i < length; ++i)
+		value = value[path[i]];
+	return value;
+}
+function run(request) {
+	switch (request.op) {
+	case 'engine':
+		return Engine[request.name](...request.args);
+	case 'log':
+		return globalThis[request.level](request.text);
+	case 'simget': {
+		const value = walk(request.root, request.path, request.path.length);
+		if (value !== null && (typeof value === 'object' || typeof value === 'function'))
+			return { kind: 'handle' };
+		return { kind: 'value', v: value };
+	}
+	case 'simcall': {
+		const last = request.path.length - 1;
+		return walk(request.root, request.path, last)[request.path[last]](...request.args);
+	}
+	case 'qi': {
+		const cmp = SimEngine.QueryInterface(request.ent, request.iid);
+		return cmp ? true : cmp;
+	}
+	case 'qicall':
+		return SimEngine.QueryInterface(request.ent, request.iid)[request.method](...request.args);
+	}
+	throw new Error('unknown AI worker request ' + request.op);
+}
+return {
+	encode: Codec.encode,
+	decode: Codec.decode,
+	dispatch(text) {
+		try {
+			return Codec.encode({ v: run(Codec.decode(text)) });
+		} catch (e) {
+			return Codec.encode({ error: String(e) + '\n' + (e && e.stack || '') });
+		}
+	},
+	engineNames() {
+		return Object.getOwnPropertyNames(Engine);
+	},
+	stateText(state) {
+		const { passabilityMap, territoryMap, ...rest } = state;
+		try {
+			return Codec.encode(rest);
+		} catch (e) {
+			// The AI may attach its own (cyclic) objects to the state.
+			return 'unencodable: ' + e;
+		}
+	},
+};
+})())JS";
+#endif // AI_REMOTE
