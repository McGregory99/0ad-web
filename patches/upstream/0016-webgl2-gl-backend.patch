diff --git a/source/renderer/backend/gl/DeviceCommandContext.cpp b/source/renderer/backend/gl/DeviceCommandContext.cpp
index 92460302..f9988828 100644
--- a/source/renderer/backend/gl/DeviceCommandContext.cpp
+++ b/source/renderer/backend/gl/DeviceCommandContext.cpp
@@ -133,6 +133,18 @@ void UploadDynamicBufferRegionImpl(
 	const CDeviceCommandContext::UploadBufferFunction& uploadFunction)
 {
 	ENSURE(dataOffset < dataSize);
+#if defined(__EMSCRIPTEN__)
+	// WebGL has no buffer mapping: fill a CPU staging buffer and upload it with
+	// glBufferSubData. Orphaning with glBufferData would make WebGL allocate and
+	// zero the whole buffer on every upload, so the rest of the buffer is kept.
+	static_cast<void>(bufferSize);
+	static std::vector<u8> staging;
+	if (staging.size() < dataSize)
+		staging.resize(dataSize);
+	uploadFunction(staging.data());
+	glBufferSubDataARB(target, dataOffset, dataSize, staging.data());
+	ogl_WarnIfError();
+#else
 	// Tell the driver that it can reallocate the whole VBO
 	glBufferDataARB(target, bufferSize, nullptr, GL_DYNAMIC_DRAW);
 	ogl_WarnIfError();
@@ -160,6 +172,7 @@ void UploadDynamicBufferRegionImpl(
 		// and hope it will eventually succeed
 		LOGMESSAGE("glUnmapBuffer failed, trying again...\n");
 	}
+#endif
 }
 
