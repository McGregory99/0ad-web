@@ -0,0 +1,45 @@
+/* Copyright (C) 2026 Wildfire Games.
+ * This file is part of 0 A.D. (browser port additions).
+ * Licensed under the same MIT terms as the rest of source/lib.
+ */
+
+// Emscripten/browser: executable path, thread names and directory watching.
+
+#include "precompiled.h"
+
+#include "lib/debug.h"
+#include "lib/sysdep/dir_watch.h"
+#include "lib/sysdep/sysdep.h"
+
+#ifdef __EMSCRIPTEN_PTHREADS__
+# include <emscripten/threading.h>
+#endif
+
+// There is no executable file in the browser. The engine derives the data
+// root from this path (binaries/system/<exe>), so return the virtual path
+// that the browser loader lays out in the in-memory filesystem
+// (Paths.cpp requires that this file exists).
+OsPath sys_ExecutablePathname()
+{
+	return OsPath("/0ad/binaries/system/pyrogenesis");
+}
+
+void debug_SetThreadName(const char* name)
+{
+#ifdef __EMSCRIPTEN_PTHREADS__
+	emscripten_set_thread_name(pthread_self(), name);
+#else
+	(void)name;
+#endif
+}
+
+// No file change notifications in the browser (hotloading is off).
+Status dir_watch_Add(const OsPath&, PDirWatch&)
+{
+	return INFO::OK;
+}
+
+Status dir_watch_Poll(DirWatchNotifications&)
+{
+	return INFO::OK;
+}
